# Copy this file to .env and adjust as needed. Every variable has a
# built-in default (see engine/config.py), so the service runs fine with
# no .env file at all - this file exists to document what's tunable.

# --- Network ---
ASTROMCP_HOST=0.0.0.0
ASTROMCP_PORT=8765
ASTROMCP_LOG_LEVEL=INFO

# --- Astrological defaults ---
# Single-letter kerykeion house system code: P=Placidus, K=Koch,
# W=Whole Sign, R=Regiomontanus, E=Equal, ...
ASTROMCP_HOUSE_SYSTEM=P
# "Tropic" or "Sidereal"
ASTROMCP_ZODIAC_TYPE=Tropic

# --- Orb tables ---
# JSON object: aspect degree -> allowed orb in degrees.
# Transits move fast (days/weeks) - wide orbs are fine.
ASTROMCP_ORB_TABLE_TRANSIT={"0":8.0,"30":2.0,"45":2.0,"60":4.0,"90":6.0,"120":6.0,"135":2.0,"150":3.0,"180":8.0}
# Directions/progressions: 1 degree of arc is roughly 1 year of life, so a
# wide orb here translates directly into years of dating error. Keep tight.
ASTROMCP_ORB_TABLE_DIRECTION={"0":1.0,"30":1.0,"45":1.0,"60":1.0,"90":1.0,"120":1.0,"135":1.0,"150":1.0,"180":1.0}

# Extra orb allowance (in degrees) added when either point in an aspect is
# the Sun or Moon.
ASTROMCP_LUMINARY_BONUS_TRANSIT=1.0
ASTROMCP_LUMINARY_BONUS_DIRECTION=0.5

# Default aspect set (JSON list of degrees) used by rectif_technique when
# the caller doesn't pass aspect_set explicitly.
ASTROMCP_ASPECT_SET=[0,30,45,60,90,120,135,150,180]

# --- rectif_scan defaults ---
# Which natal points a scan candidate's score counts hits against, by
# default (JSON list). ASC/MC are the most birth-time-sensitive points;
# Sun/Moon add signal without exploding the search space.
ASTROMCP_SCAN_TARGET_POINTS=["ascendant","medium_coeli","descendant","imum_coeli","sun","moon"]
# Aspect degrees a scan checks by default (JSON list) - hard aspects only,
# since soft/minor aspects add noise without much rectification value.
ASTROMCP_SCAN_ASPECT_SET=[0,90,180]
# Maximum orb (degrees) for an aspect to count as a "hit" in scan scoring.
ASTROMCP_SCAN_ORB_THRESHOLD=1.5

# --- Console output ---
# When true, every tool call also prints a human-readable summary of its
# result to the server console/journal (in addition to the MCP response),
# so `journalctl -u astromcp -f` shows something meaningful, not just
# "request received".
ASTROMCP_CONSOLE_RESULT_PREVIEW=true

# --- /astro/chart.svg photo embedding (engine/photo_fetch.py) ---
# Empty by default - photo_url is simply ignored (fails closed) until you
# set this. Required because a publicly reachable endpoint that fetches
# any URL a caller hands it is an SSRF surface - set this to your own
# wiki's file-serving host(s), comma-separated for more than one prefix.
# Example for a wiki at sociowiki.sphynkx.org.ua with local file storage:
ASTROMCP_PHOTO_ALLOWED_PREFIXES=https://sociowiki.sphynkx.org.ua/
ASTROMCP_PHOTO_FETCH_TIMEOUT_SECONDS=4.0
ASTROMCP_PHOTO_FETCH_MAX_BYTES=3145728
